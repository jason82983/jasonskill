{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["BatchId", "ProductProfileId", "BrainVersion", "Judgments"],
  "properties": {
    "BatchId": {"type": "string", "minLength": 1},
    "ProductProfileId": {"type": "string", "minLength": 1},
    "BrainVersion": {"type": "string", "minLength": 1},
    "Judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["JudgmentItemId", "FinalPrecision", "JudgmentStatus", "ReasonCode", "ShortReason", "HardConflictType", "BenchmarkRealityAssessment", "ChallengeResult"],
        "properties": {
          "JudgmentItemId": {"type": "string", "minLength": 1},
          "FinalPrecision": {"type": "string", "enum": ["高度精准", "精准", "弱精准", "不精准", "DATA_NOT_AVAILABLE"]},
          "JudgmentStatus": {"type": "string", "enum": ["SUCCESS", "REVIEW_REQUIRED", "FAILED"]},
          "ReasonCode": {"type": "string", "minLength": 1},
          "ShortReason": {"type": "string", "minLength": 1},
          "HardConflictType": {"type": "string"},
          "BenchmarkRealityAssessment": {"type": "string", "enum": ["SUPPORTS", "WEAKLY_SUPPORTS", "NEUTRAL", "CONTRADICTS", "INSUFFICIENT"]},
          "ChallengeResult": {"type": "string", "enum": ["CONFIRMED", "DOWNGRADED", "UPGRADED", "RECONSIDERED_NO_CHANGE", "DATA_NOT_AVAILABLE"]}
        }
      }
    }
  }
}
